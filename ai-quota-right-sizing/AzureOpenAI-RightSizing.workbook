    {
      "type": 1,
      "name": "inventory-title",
      "content": {
        "json": "## Live capacity drilldown\nChoose one account from the multi-account scope to compare observed demand with live deployment allocation. Inventory includes **all models** in this account. A blank demand value means no usable rows under the current model/category filters, **not zero use**. Inventory is current state, not a historical snapshot."
      }
    },
    {
      "type": 9,
      "name": "capacity-scope",
      "content": {
        "version": "KqlParameterItem/1.0",
        "parameters": [
          {
            "id": "CapacityAccount",
            "version": "KqlParameterItem/1.0",
            "name": "CapacityAccount",
            "type": 5,
            "label": "Capacity drilldown account",
            "isRequired": true,
            "query": "Resources | where type =~ 'microsoft.cognitiveservices/accounts'\n| where id in~ ({Accounts}) | order by name asc\n| project value=id, label=name",
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources",
            "crossComponentResources": [
              "{Subscriptions}"
            ],
            "defaultValue": "value::1",
            "typeSettings": {
              "additionalResourceOptions": [
                "value::1"
              ],
              "showDefault": false
            }
          }
        ],
        "style": "above"
      }
    },
    {
      "type": 3,
      "name": "inventory",
      "content": {
        "version": "KqlItem/1.0",
        "title": "Current deployment allocation - selected account, all models",
        "query": "{\"version\": \"ARMEndpoint/1.0\", \"method\": \"GETARRAY\", \"path\": \"{CapacityAccount}/deployments\", \"urlParams\": [{\"key\": \"api-version\", \"value\": \"2024-10-01\"}], \"transformers\": [{\"type\": \"jsonpath\", \"settings\": {\"tablePath\": \"$..[?(@.type == 'Microsoft.CognitiveServices/accounts/deployments')]\", \"columns\": [{\"columnid\": \"Deployment\", \"path\": \"$.name\", \"columnType\": \"string\"}, {\"columnid\": \"ConfiguredModel\", \"path\": \"$.properties.model.name\", \"columnType\": \"string\"}, {\"columnid\": \"ConfiguredVersion\", \"path\": \"$.properties.model.version\", \"columnType\": \"string\"}, {\"columnid\": \"SKU\", \"path\": \"$.sku.name\", \"columnType\": \"string\"}, {\"columnid\": \"CapacityUnits\", \"path\": \"$.sku.capacity\", \"columnType\": \"real\"}, {\"columnid\": \"AllocatedTPM\", \"path\": \"$.properties.rateLimits[?(@.key == 'token' && @.renewalPeriod == 60)].count\", \"columnType\": \"real\"}, {\"columnid\": \"RequestLimit\", \"path\": \"$.properties.rateLimits[?(@.key == 'request')].count\", \"columnType\": \"real\"}, {\"columnid\": \"RequestWindowSeconds\", \"path\": \"$.properties.rateLimits[?(@.key == 'request')].renewalPeriod\", \"columnType\": \"real\"}, {\"columnid\": \"ProvisioningState\", \"path\": \"$.properties.provisioningState\", \"columnType\": \"string\"}]}}]}",
        "size": 0,
        "queryType": 12,
        "visualization": "table",
        "showExportToExcel": true
      }
    },
    {
      "type": 3,
      "name": "focus-demand",
      "content": {
        "version": "KqlItem/1.0",
        "title": "Selected account diagnostic demand",
        "query": "let RequestedStart = datetime({TimeRange:startISO});\nlet RequestedEnd = datetime({TimeRange:endISO});\nlet Start = bin(RequestedStart, 1m) + iff(RequestedStart == bin(RequestedStart, 1m), 0m, 1m);\nlet End = bin(min_of(RequestedEnd, now() - 5m), 1m);\nlet CalendarMinutes = datetime_diff('minute', End, Start);\nlet WindowValid = CalendarMinutes between (1 .. 44640);\nlet TokenCount = (v:dynamic) {\n    iff(gettype(v) == \"array\", tolong(array_sum(v)), tolong(v))\n};\nlet Raw = materialize(\n    AzureDiagnostics\n    | where TimeGenerated >= Start and TimeGenerated < End\n    | where ResourceProvider =~ \"MICROSOFT.COGNITIVESERVICES\"\n    | where Category == '{LogCategory}'\n    | extend AccountId = tolower(coalesce(_ResourceId, ResourceId)),\n             p = parse_json(tostring(column_ifexists(\"properties_s\", \"\")))\n    | extend SubscriptionId = tostring(split(AccountId, \"/\")[2]),\n             Account = tostring(split(AccountId, \"/\")[8]),\n             Deployment = tostring(p.modelDeploymentName),\n             Model = iff(isempty(tostring(p.modelName)), \"(unknown model)\", tostring(p.modelName)),\n             Version = tostring(p.modelVersion),\n             ExplicitRequestId = coalesce(tostring(p.requestId), tostring(column_ifexists(\"requestId_s\", \"\"))),\n             CorrelationId = tolower(tostring(column_ifexists(\"CorrelationId\", \"\"))),\n             Operation = tostring(column_ifexists(\"OperationName\", \"\")),\n             Prompt = TokenCount(p.promptTokens),\n             OutputValue = iff(Category == \"AzureOpenAIRequestUsage\", p.generatedTokens, p.completionTokens)\n    | extend Output = TokenCount(OutputValue),\n             CorrelationId = iff(CorrelationId == \"00000000-0000-0000-0000-000000000000\", \"\", CorrelationId)\n    | extend RequestId = coalesce(ExplicitRequestId, CorrelationId)\n    | where AccountId in~ ({Accounts})\n    | where \"*\" in ({Models}) or Model in ({Models})\n    | extend HasTokens = isnotnull(p.promptTokens) or isnotnull(OutputValue)\n    | extend ValidTokens = HasTokens\n        and (isnull(p.promptTokens) or (isnotnull(Prompt) and Prompt >= 0))\n        and (isnull(OutputValue) or (isnotnull(Output) and Output >= 0))\n    | extend EventSignature = tostring(pack_array(Operation, Model, Version, HasTokens,\n                                                  ValidTokens, Prompt, Output))\n    | project TimeGenerated, AccountId, SubscriptionId, Account, Deployment, Model, Version, RequestId,\n              EventSignature,\n              WorkspaceId = tostring(TenantId), HasTokens, ValidTokens,\n              Tokens = coalesce(Prompt, 0) + coalesce(Output, 0)\n);\nlet MultiWorkspaceAccounts = (\n    Raw | where HasTokens\n    | summarize by AccountId, WorkspaceId\n    | summarize Workspaces = count() by AccountId\n    | where Workspaces > 1\n);\nlet AmbiguousRows = toscalar(\n    Raw | where HasTokens and isempty(RequestId)\n    | join kind=inner MultiWorkspaceAccounts on AccountId\n    | count\n);\nlet Identified = materialize(\n    Raw | where HasTokens and isnotempty(RequestId)\n    | summarize Copies = count(), Signatures = make_set(EventSignature, 2),\n                FirstTime = min(TimeGenerated), LastTime = max(TimeGenerated),\n                arg_min(TimeGenerated, *) by AccountId, Deployment, RequestId\n);\nlet ConflictingRequests = toscalar(\n    Identified | summarize countif(array_length(Signatures) > 1 or LastTime - FirstTime >= 1m)\n);\nlet DeploymentConflicts = toscalar(\n    Raw | where HasTokens and isnotempty(RequestId)\n    | summarize Missing = countif(isempty(Deployment)), Named = countif(isnotempty(Deployment))\n        by AccountId, RequestId\n    | summarize countif(Missing > 0 and Named > 0)\n);\nlet ReusedIdsInWorkspace = toscalar(\n    Raw | where HasTokens and isnotempty(RequestId)\n    | summarize Times = make_set(TimeGenerated, 2) by AccountId, Deployment, RequestId, WorkspaceId\n    | summarize countif(array_length(Times) > 1)\n);\nlet DuplicateRows = toscalar(\n    Identified | summarize sum(Copies - 1)\n);\nlet Deduplicated = materialize(\n    union (Identified | project-away Copies, Signatures, FirstTime, LastTime),\n          (Raw | where HasTokens and isempty(RequestId))\n);\nlet InvalidRows = toscalar(\n    Raw | summarize countif(HasTokens and not(ValidTokens))\n);\nlet DataValid = WindowValid and AmbiguousRows == 0 and ConflictingRequests == 0\n    and DeploymentConflicts == 0 and ReusedIdsInWorkspace == 0 and InvalidRows == 0;\nlet Usage = materialize(\n    Deduplicated\n    | where DataValid and ValidTokens\n    | extend Minute = bin(TimeGenerated, 1m),\n             EntityKey = tostring(pack_array(AccountId, Deployment))\n);\nlet Active = materialize(\n    Usage\n    | extend GroupKey = EntityKey\n    | summarize TPM = sum(Tokens), RPM = count() by GroupKey, Minute\n);\nlet Histogram =\n    union\n        (Active | summarize Weight = count() by GroupKey, TPM),\n        (Active | summarize ObservedMinutes = count() by GroupKey\n         | project GroupKey, TPM = tolong(0), Weight = CalendarMinutes - ObservedMinutes)\n    | where Weight > 0\n    | summarize Weight = sum(Weight) by GroupKey, TPM;\nlet Statistics =\n    Histogram\n    | order by GroupKey asc, TPM asc\n    | serialize\n    | extend CumulativeMinutes = row_cumsum(Weight, GroupKey != prev(GroupKey))\n    | summarize ObservedTokens = sum(TPM * Weight),\n                AverageTPM = sum(todouble(TPM) * Weight) / CalendarMinutes,\n                P50TPM = minif(TPM, CumulativeMinutes >= ceiling(CalendarMinutes * 0.50)),\n                P95TPM = minif(TPM, CumulativeMinutes >= ceiling(CalendarMinutes * 0.95)),\n                P99TPM = minif(TPM, CumulativeMinutes >= ceiling(CalendarMinutes * 0.99)),\n                PeakTPM = max(TPM)\n        by GroupKey;\nStatistics\n| join kind=inner (\n    Active | summarize PeakRPM = max(RPM), ActiveMinutes = countif(TPM > 0) by GroupKey\n) on GroupKey\n| project-away GroupKey1\n| extend CalendarMinutes = CalendarMinutes, StartUTC = Start, EndUTCExclusive = End,\n         P99WithHeadroomTPM = ceiling(P99TPM * {Headroom}),\n         PeakWithHeadroomTPM = ceiling(PeakTPM * {Headroom})\n\n| join kind=inner (\n    Usage | summarize Models=make_set(Model, 100), Versions=make_set(Version, 100) by EntityKey\n) on $left.GroupKey == $right.EntityKey\n| extend Key=parse_json(GroupKey)\n| where isnotempty(tostring(Key[1]))\n| project AccountId=tostring(Key[0]), Deployment=tostring(Key[1]),\n          Models, Versions,\n          AverageTPM, P50TPM, P95TPM, P99TPM, PeakTPM, PeakRPM,\n          P99WithHeadroomTPM, PeakWithHeadroomTPM, ObservedTokens, ActiveMinutes, CalendarMinutes\n| order by PeakTPM desc\n\n| where AccountId =~ '{CapacityAccount}'\n| project Deployment, AverageTPM, PeakTPM, P99WithHeadroomTPM, PeakWithHeadroomTPM,\n          VersionsInWindow=array_length(Versions)\n",
        "size": 0,
        "queryType": 0,
        "visualization": "table",
        "showExportToExcel": true,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspaces}"
        ],
        "timeContextFromParameter": "TimeRange"
      }
    },
    {
      "type": 3,
      "name": "capacity-comparison",
      "content": {
        "version": "KqlItem/1.0",
        "title": "Allocation vs observed planning targets",
        "query": "{\"version\": \"Merge/1.0\", \"merges\": [{\"id\": \"capacity-demand\", \"mergeType\": \"leftouter\", \"leftTable\": \"inventory\", \"rightTable\": \"focus-demand\", \"leftColumn\": \"Deployment\", \"rightColumn\": \"Deployment\"}], \"projectRename\": [{\"originalName\": \"[inventory].Deployment\", \"mergedName\": \"Deployment\", \"fromId\": \"capacity-demand\"}, {\"originalName\": \"[inventory].ConfiguredModel\", \"mergedName\": \"ConfiguredModel\", \"fromId\": \"capacity-demand\"}, {\"originalName\": \"[inventory].ConfiguredVersion\", \"mergedName\": \"ConfiguredVersion\", \"fromId\": \"capacity-demand\"}, {\"originalName\": \"[inventory].SKU\", \"mergedName\": \"SKU\", \"fromId\": \"capacity-demand\"}, {\"originalName\": \"[inventory].CapacityUnits\", \"mergedName\": \"CapacityUnits\", \"fromId\": \"capacity-demand\"}, {\"originalName\": \"[inventory].AllocatedTPM\", \"mergedName\": \"AllocatedTPM\", \"fromId\": \"capacity-demand\"}, {\"originalName\": \"[focus-demand].AverageTPM\", \"mergedName\": \"AverageTPM\", \"fromId\": \"capacity-demand\"}, {\"originalName\": \"[focus-demand].P99WithHeadroomTPM\", \"mergedName\": \"P99WithHeadroomTPM\", \"fromId\": \"capacity-demand\"}, {\"originalName\": \"[focus-demand].PeakWithHeadroomTPM\", \"mergedName\": \"PeakWithHeadroomTPM\", \"fromId\": \"capacity-demand\"}, {\"originalName\": \"[focus-demand].VersionsInWindow\", \"mergedName\": \"VersionsInWindow\", \"fromId\": \"capacity-demand\"}]}",
        "size": 0,
        "queryType": 7,
        "visualization": "table",
        "showExportToExcel": true
      }
    },
    {
      "type": 1,
      "name": "capacity-notes",
      "content": {
        "json": "`AllocatedTPM` comes from the explicit token rate limit with a 60-second renewal period; missing limits stay blank. `CapacityUnits` are not universally TPM: provisioned SKUs use PTUs. Request limits may have shorter renewal windows; read `RequestWindowSeconds` before comparing with RPM. Traffic across model versions is combined for each physical deployment; historical allocations are not reconstructed. Do not interpret the ratio of observed tokens to allocation as Azure admission-rate utilization. Validate PTU changes with utilization V2, latency and load tests; no generic TPM-to-PTU conversion is applied."
      }
    }
  ],
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
}
